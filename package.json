{
  "name": "steamdeck-input-disabler",
  "version": "1.1.0",
  "description": "Disables the Steam Deck's built-in gamepad when a supported external controller connects. Includes a user-extensible allowlist and a controller ID extractor.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
