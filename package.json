    "type": "git",
    "url": "git+https://github.com/BurritoSpray/steamdeck-input-disabler.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "bluetooth",
    "controller",
    "steam-deck",
    "deck"
  ],
  "author": "William Goyette <willpower1@live.ca>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/BurritoSpray/steamdeck-input-disabler/issues"
  },
  "homepage": "https://github.com/BurritoSpray/steamdeck-input-disabler#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
